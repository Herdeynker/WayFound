# Public browser-safe configuration. Use local values for development.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase publishable key may be used instead of the legacy anon name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Required in production; never expose these to browser code.
APP_URL=
SUPABASE_URL=
# Supabase's server-only secret key. Never expose it to browser code.
SUPABASE_SECRET_KEY=
# Legacy name supported for older Supabase projects; leave empty when using SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Optional provider configuration. Leave empty to use controlled disabled adapters.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Phase 15 autonomous discovery. Keep the Brave key server-only and disabled until configured.
OPPORTUNITY_DISCOVERY_ENABLED=false
OPPORTUNITY_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
OPPORTUNITY_SEARCH_DAILY_LIMIT=25
OPPORTUNITY_SEARCH_MONTHLY_LIMIT=750
OPPORTUNITY_SEARCH_RESULTS_PER_QUERY=20
OPPORTUNITY_PAID_OVERAGE_ALLOWED=false
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
NOTIFICATIONS_CRON_ENABLED=false
NOTIFICATION_BATCH_SIZE=25
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEEKLY_PLAN_CODE=
PAYSTACK_MONTHLY_PLAN_CODE=
PAYSTACK_YEARLY_PLAN_CODE=
PAYSTACK_ENVIRONMENT=
BILLING_CRON_ENABLED=false
BILLING_BATCH_SIZE=20
SENTRY_DSN=
CRON_SECRET=
INGESTION_CRON_ENABLED=false
INGESTION_MAX_SOURCES=4
UPLOAD_SCANNER_PROVIDER=
UPLOAD_SCANNER_URL=
UPLOAD_SCANNER_TOKEN=
UPLOAD_SCANNER_ALLOWED_HOST=

# Feature flags use true/false and default to safe disabled values.
FEATURE_FLAGS_JSON={}
GOOGLE_OAUTH_ENABLED=false
PHASE2_POLICY_VERSION=2026-09-08.v1
ACCOUNT_DELETION_GRACE_DAYS=30
