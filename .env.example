# Public browser-safe configuration. Use local values for development.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required in production; never expose these to browser code.
APP_URL=
SUPABASE_URL=
# Supabase's server-only secret key. Never expose it to browser code.
SUPABASE_SECRET_KEY=
# Legacy name supported for older Supabase projects; leave empty when using SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Optional provider configuration. Leave empty to use controlled disabled adapters.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
DISCOVERY_PROVIDER=
DISCOVERY_API_KEY=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
SENTRY_DSN=
CRON_SECRET=

# Feature flags use true/false and default to safe disabled values.
FEATURE_FLAGS_JSON={}
